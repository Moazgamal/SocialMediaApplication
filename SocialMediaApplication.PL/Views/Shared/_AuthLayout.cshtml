<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/css/authlayout.css" rel="stylesheet" />
</head>
<body>
    <div class="container-div">
        <div class="Left-Side">
            @RenderBody()
        </div>
        <div class="Right-Side">
            @if(ViewBag.Title == "SignUp")
            {
                <div class="slide active" >
                    <img src="~/images/man1.jpg" />
                </div>
                
            }
            else
            {
                <div class="slide active">
                    <img src="~/images/man1.jpg" />
                </div>
            }
            @* <div class="slide" >
                <img src="~/images/man2.jpg"/>
            </div> *@
        </div>
    </div>
    
    @* @await RenderSectionAsync("ValidationScriptsSection", required: false) *@
</body>
</html>
