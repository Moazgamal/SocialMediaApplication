@model PostToReturnViewModel;
<div id="post">
<div class="post-header">
    <input type="hidden" name="PostId" value="@Model.Id" readonly/>
    <div class="user-name-and-image">
         <div class="post-username"><img class="user-image" src="~/files/images/@Model.creatingUserImageName" alt="User Image" /></div> 
        @* <div class="post-username"><img class="user-image" src="~/images/@Model.creatingUser.profilePictureName" alt="User Image" /></div> *@
        <div class="post-date-and-user">
            <p style="font-size:18px;margin:0px;margin-bottom:3px; font-weight:bold; font-family:Calibri;">@Model.creatingUserName</p> 
            @* <p style="font-size:18px;margin:0px;margin-bottom:3px; font-weight:bold; font-family:Calibri;">@Model.creatingUser.UserName</p> *@
            <p style="margin:0;opacity:0.4;margin-bottom:3px; font-size:smaller;">5 followers</p>
        </div>
    </div>
    <div class="setting-points">
        <a class="setting-points-container" id="setting-points-container-@Model.Id"  data-post-id="@Model.Id">
            <span></span>
            <span></span>
            <span></span>
        </a>
        <div id="post-user-settings-@Model.Id" class="post-user-settings">
            <div>
            <a >Update</a>
            </div>
            <div>
            <a >Delete</a>
            </div>
            <div>
            <a >Hide</a>
            </div>
        </div>
        <div id="post-friend-settings-@Model.Id" class="post-friend-settings">
            <div>
            <a >Hide</a>
            </div>
        </div>
    </div>
    
</div>
<div class="created-post-text">
    <textarea readonly>@Model.postText</textarea>
</div>
<div class="created-post-image">
    <img src="~/files/images/@Model.postImageName" alt="Preview">
</div>
</div>