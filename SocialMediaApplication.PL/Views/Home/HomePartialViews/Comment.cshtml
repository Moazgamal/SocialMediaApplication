@using SocialMediaApplication.PL.ViewModels.Comment
@model CommentToReturnViewModel

<div class="comment" id="comment-@Model.Id">

    <img src="~/files/images/Users/@Model.UserImageName" class="user-image"/>
    <div class="comment-content">

        <div class="comment-top">
            <strong>@Model.UserName</strong>

            <div class="comment-menu-container" data-comment-id="@Model.Id">
                <button class="comment-menu-btn">⋯</button>

                <div class="comment-menu">
                    @* <button class="edit-comment">Edit</button>
                    <button class="delete-comment">Delete</button> *@
                </div>
            </div>
        </div>

    <div>


        <p>@Model.Content</p>
        <div class="comment-actions">
        <div>
            <span id="comment-likes-@Model.Id">@Model.NumberOfLikes</span>

            @if(Model.IsLikedByCurrentUser)
            {
                <button id="like-comment" class="like-comment color-blue" data-comment-id="@Model.Id">
                    Like
                </button>
            }
            else
            {
                <button id="like-comment" class="like-comment" data-comment-id="@Model.Id">
                    Like
                </button>
            }
        </div>
        </div>
    </div>
    </div>

</div>