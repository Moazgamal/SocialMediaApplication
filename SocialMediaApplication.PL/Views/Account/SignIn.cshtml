@model SignInViewModel
@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
<div asp-validation-summary="ModelOnly"></div>
<form asp-action="SignIn" method="post">
    <input asp-for="Email" placeholder="Email" />
    <input asp-for="Password" placeholder="Password" />
    <div class="IsAgree">
        <input asp-for="RememberMe" type="checkbox" />
        <span>Remember Me?</span>
    </div>
    <input type="submit" value="Sign In" />
</form>
<p class="account-question">You don't have an Account? <a asp-action="SignUp">Register Now!</a></p>
<p class="account-question"><a asp-action="ForgetPassword">Forget Your Password?</a></p>

@section ValidationScriptsSection {
    <partial name="_ValidationScriptsPartial" />
}
