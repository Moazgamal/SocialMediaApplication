@model SignUpViewModel
@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewBag.Title = "SignUp";
}
<div asp-validation-summary="ModelOnly"></div>
<form asp-action="SignUp" method="post" enctype="multipart/form-data">
    <input asp-for="FirstName" placeholder="First Name" />
    <span asp-validation-for="FirstName"></span>
    <input asp-for="LastName" placeholder="Last Name" />
    <span asp-validation-for="LastName"></span>
    <input asp-for="UserName" placeholder="Username" />
    <span asp-validation-for="UserName"></span>
    <input asp-for="Email" placeholder="Email"/>
    <span asp-validation-for="Email"></span>
    <input asp-for="Password" placeholder="Password" />
    <span asp-validation-for="Password"></span>
    <input asp-for="ConfirmPassword" placeholder="Confirm Password" />
    <span asp-validation-for="ConfirmPassword"></span>
    <input asp-for="profilePicture" accept="image/*" placeholder=" Upload Picture" />
    <span asp-validation-for="profilePicture"></span>
    <div class="IsAgree">
        <input asp-for="IsAgree" type="checkbox"/>
        @* <span asp-validation-for="IsAgree"></span> *@
        <span>I Agree To The Terms & Conditions</span>
    </div>
    <input type="submit" value="Sign Up"/>
</form>
<p class="account-question">Do you have an Account? <a asp-action="SignIn">Login Now!</a></p>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

